.history-page{background-color:#f5f5f5;min-height:100vh}.history-page__empty{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;padding-top:240rpx}.history-page__empty-icon{-webkit-align-items:center;border:4rpx solid #e5e5e5;border-radius:16rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;height:96rpx;width:96rpx;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.history-page__empty-icon-inner{background-color:#f0f0f0;border-radius:8rpx;height:40rpx;width:40rpx}.history-page__empty-text{color:#666;font-size:32rpx;margin-top:24rpx}.history-page__empty-hint{color:#999;font-size:26rpx;margin-top:12rpx}.history-page__toolbar{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:center;align-items:center;-webkit-justify-content:space-between;-ms-flex-pack:justify;justify-content:space-between;padding:24rpx 32rpx}.history-page__count{color:#999;font-size:26rpx}.history-page__clear{color:#ff3b30;font-size:26rpx}.history-page__list{padding:0 32rpx 48rpx}.history-page__item{-webkit-align-items:flex-start;display:-webkit-flex;display:-ms-flexbox;display:flex;-ms-flex-align:start;align-items:flex-start;background-color:#fff;border-radius:16rpx;margin-bottom:20rpx;padding:20rpx}.history-page__item-image{background-color:#f5f5f5;border-radius:12rpx;-webkit-flex-shrink:0;height:140rpx;width:140rpx;-ms-flex-negative:0;flex-shrink:0}.history-page__item-info{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex:1;-ms-flex:1;flex:1;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-justify-content:space-between;margin-left:20rpx;-ms-flex-pack:justify;justify-content:space-between;min-height:140rpx}.history-page__item-prompt{color:#000;display:-webkit-box;font-size:26rpx;-webkit-line-clamp:2;line-height:1.4;-webkit-box-orient:vertical;overflow:hidden}.history-page__item-meta{display:-webkit-flex;display:-ms-flexbox;display:flex;gap:12rpx;margin-top:12rpx}.history-page__item-tag{background-color:#f5f5f5;border-radius:6rpx;color:#666;font-size:20rpx;padding:4rpx 12rpx}.history-page__item-time{color:#999;font-size:22rpx;margin-top:12rpx}.history-page__item-save{-webkit-flex-shrink:0;-ms-flex-negative:0;-webkit-align-self:flex-start;flex-shrink:0;-ms-flex-item-align:start;align-self:flex-start;background-color:#000;border-radius:12rpx;margin-left:12rpx;margin-top:12rpx;padding:12rpx 24rpx}.history-page__item-save-text{color:#fff;font-size:24rpx}.history-page__preview{-webkit-align-items:center;background-color:rgba(0,0,0,.9);bottom:0;display:-webkit-flex;display:-ms-flexbox;display:flex;left:0;position:fixed;right:0;top:0;z-index:1000;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center}.history-page__preview-image{max-height:80vh;width:100%}