.custom-tabbar{background-color:#fff;border-top:2rpx solid #f0f0f0;bottom:0;display:-webkit-flex;display:-ms-flexbox;display:flex;height:100rpx;left:0;padding-bottom:env(safe-area-inset-bottom);position:fixed;right:0;z-index:999}.custom-tabbar__item{-webkit-align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex:1;-ms-flex:1;flex:1;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-ms-flex-align:center;align-items:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;position:relative}.custom-tabbar__text{color:#999;font-size:20rpx;margin-top:4rpx}.custom-tabbar__text--active{color:#000}.custom-tabbar__icon{height:48rpx;position:relative;width:48rpx}.custom-tabbar__icon--sparkle::before{background-color:#999;border-radius:4rpx;content:"";height:28rpx;left:50%;margin-left:-14rpx;margin-top:-14rpx;position:absolute;top:50%;-webkit-transform:rotate(45deg);-ms-transform:rotate(45deg);transform:rotate(45deg);-webkit-transition:background-color .2s ease;transition:background-color .2s ease;width:28rpx}.custom-tabbar__icon--sparkle::after{background-color:#fff;border-radius:50%;content:"";height:8rpx;left:50%;margin-left:-4rpx;margin-top:-4rpx;position:absolute;top:50%;width:8rpx;z-index:1}.custom-tabbar__icon--sparkle.custom-tabbar__icon--on::before{background-color:#000}.custom-tabbar__icon--user::before{background-color:#999;border-radius:50%;content:"";height:16rpx;left:50%;margin-left:-8rpx;position:absolute;top:10rpx;-webkit-transition:background-color .2s ease;transition:background-color .2s ease;width:16rpx}.custom-tabbar__icon--user::after{background-color:#999;border-radius:16rpx 16rpx 0 0;bottom:8rpx;content:"";height:20rpx;left:50%;margin-left:-16rpx;position:absolute;-webkit-transition:background-color .2s ease;transition:background-color .2s ease;width:32rpx}.custom-tabbar__icon--user.custom-tabbar__icon--on::after,.custom-tabbar__icon--user.custom-tabbar__icon--on::before{background-color:#000}